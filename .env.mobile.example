# Adresse publique actuelle de StoreHub. Elle peut être remplacée plus tard
# par un domaine personnalisé sans recréer le projet Android.
VITE_PUBLIC_URL="https://store-hub-2026.web.app"

# À renseigner lorsque l'API Express sera publiée sur une adresse HTTPS.
# Vide, l'application utilise les routes /api du même serveur en développement.
VITE_API_ORIGIN=""

# Développement uniquement : charge l'application Vite depuis l'émulateur.
# Ne pas définir cette variable pour une construction destinée au Play Store.
CAPACITOR_SERVER_URL="http://10.0.2.2:3000"
