rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // In this full-stack architecture, the Node.js Express server acts as a secure backend proxy.
    // The server initializes the Firestore Client SDK, meaning operations are unauthenticated
    // from Firestore's perspective. Therefore, we permit read and write access for these collections.

    // Boutiques collection
    match /boutiques/{boutiqueId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Users collection (For Client and Boutique user profiles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Collections (Product groupings)
    match /collections/{collectionId} {
      allow read, write: if true;
    }
  }
}
