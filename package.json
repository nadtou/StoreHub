{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:functions": "esbuild functions-entry.mjs --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=functions/index.cjs",
    "build:firebase": "npm run build:web && npm run build:functions",
    "build:mobile": "vite build --mode mobile --outDir dist-mobile",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-emulator.ps1",
    "deploy:firebase": "npm run build:firebase && firebase deploy --project store-hub-2026",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/productSizes.test.ts tests/phase2Flows.test.ts tests/imageCompression.test.ts tests/appCheck.test.ts tests/runtimeUrls.test.ts tests/corsPolicy.test.ts",
    "test:rules:only": "tsx --test --test-concurrency=1 tests/firestore.rules.test.ts tests/storage.rules.test.ts",
    "test:rules": "node scripts/run-firebase-rule-tests.mjs",
    "test:backup": "node scripts/verify-backup-restore.mjs",
    "verify": "npm run lint && npm run test:unit && npm run test:rules && npm run test:backup && npm run build && npm audit --audit-level=high"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.30.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
